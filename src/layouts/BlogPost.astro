---
import type { MarkdownHeading } from 'astro'
import { type CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, Hero, RelatedPosts, TOC } from 'astro-pure/components/pages'
import { getRelatedPosts } from 'astro-pure/server'
import config from 'virtual:config'
import BlogPostingJsonLd from '@/components/BlogPostingJsonLd.astro'
import PageLayout from '@/layouts/ContentLayout.astro'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post,
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const { id, data } = post
const { description, heroImage, publishDate, title, updatedDate, draft: isDraft } = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'

// Related: 4 cards by default, shown when not a draft
const relatedPosts = isDraft ? [] : getRelatedPosts(post, posts, 4)
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
>
  <BlogPostingJsonLd
    slot='head'
    title={title}
    description={description}
    slug={id}
    publishDate={publishDate}
    updatedDate={updatedDate}
    image={socialImage}
    author={config.author}
    siteName={config.title}
  />
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header' />

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article navigation: previous / next */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {/* Related: tag-overlap based, shown only when not draft */}
    {!isDraft && <RelatedPosts current={post} related={relatedPosts} class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}