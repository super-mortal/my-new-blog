---
import {Button} from 'astro-pure/user'
import {getBlogCollection, sortMDByDate} from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Page not found',
  title: '404'
}

// 6 篇最新文章作为推荐 (按发布日期倒序)
const recommendedPosts = sortMDByDate(await getBlogCollection()).slice(0, 6)
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>Oops, something went wrong.</p>
    <p class='text-lg'>Sorry, we couldn't find your page.</p>

    {/* 搜索框 (Pagefind) */}
    <div class='mx-auto mt-8 max-w-xl'>
      <a
        href='/search'
        class='group flex items-center gap-3 rounded-xl border bg-background px-4 py-3 transition-colors hover:border-primary/40 hover:bg-muted/60'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='text-muted-foreground transition-colors group-hover:text-primary'
        >
          <circle cx='11' cy='11' r='8' />
          <line x1='21' y1='21' x2='16.65' y2='16.65' />
        </svg>
        <span class='text-sm text-muted-foreground transition-colors group-hover:text-foreground'>
          搜索文章... (按标题、描述、标签)
        </span>
      </a>
    </div>

    <Button title='Back to home' href='/' variant='ahead' class='mt-5' />
  </div>

  {/* 推荐文章 */}
  {recommendedPosts.length > 0 && (
    <section class='mx-auto mt-16 max-w-5xl'>
      <h2 class='mb-6 text-center text-xl font-medium sm:text-2xl'>或者看看这些文章</h2>
      <ul class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
        {recommendedPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class='group flex h-full flex-col gap-2 rounded-xl border bg-card/40 p-4 transition-colors duration-300 hover:border-primary/40 hover:bg-muted/60'
            >
              <h3 class='line-clamp-2 text-sm font-medium transition-colors group-hover:text-primary sm:text-base'>
                {post.data.title}
              </h3>
              <p class='line-clamp-2 text-xs text-muted-foreground sm:text-sm'>
                {post.data.description}
              </p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class='mt-auto flex flex-wrap gap-1 pt-2'>
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class='rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>
